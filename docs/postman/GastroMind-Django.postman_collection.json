      "name": "6. Costo del platillo (Django, HU-08)",
      "item": [
        {
          "name": "CA-08: carta con el costo de cada platillo (seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const carta = pm.response.json();",
                  "const p = nombre => carta.find(x => x.nombre === nombre);",
                  "pm.test('Cada platillo trae costo, margen y porcentaje_costo', () => carta.forEach(x => pm.expect(x).to.include.keys('costo', 'margen', 'porcentaje_costo')));",
                  "pm.test('Arroz con pollo: costo S/ 4.35 (Σ cantidad × costo de sus 5 insumos)', () => pm.expect(p('Arroz con pollo').costo).to.eql('4.35'));",
                  "pm.test('Lomo saltado: costo 9.87, margen 22.13, 30.8 % del precio', () => { const l = p('Lomo saltado'); pm.expect([l.costo, l.margen, l.porcentaje_costo]).to.eql(['9.87', '22.13', '30.8']); });",
                  "pm.test('Chicha morada (sin receta): costo 0.00', () => pm.expect(p('Chicha morada (jarra)').costo).to.eql('0.00'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{django}}/api/catalogo/productos/"
          }
        },
        {
          "name": "Insumo Arroz (guarda su id)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const arroz = pm.response.json().find(i => i.nombre === 'Arroz');",
                  "pm.test('Existe el Arroz (seed_demo.sql)', () => pm.expect(arroz).to.exist);",
                  "pm.collectionVariables.set('arrozId', arroz.id);",
                  "pm.collectionVariables.set('arrozCosto', arroz.costo_unitario);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{django}}/api/catalogo/insumos/?search=Arroz"
          }
