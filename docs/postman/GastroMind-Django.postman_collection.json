          "name": "CA-08: receta del platillo nuevo → el costo se calcula",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const esperado = (0.2 * Number(pm.collectionVariables.get('arrozCosto'))).toFixed(2);",
                  "pm.test('costo = 0.200 × costo del Arroz', () => pm.expect(r.costo).to.eql(esperado));",
                  "pm.test('margen = precio − costo', () => pm.expect(Number(r.margen)).to.be.closeTo(Number(r.precio) - Number(r.costo), 0.001));"
                ]
