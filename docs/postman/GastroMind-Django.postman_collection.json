    {
      "name": "5. Gestionar la carta (Django, HU-07)",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{token}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Categorías (Central): guarda Fondos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const fondos = pm.response.json().find(c => c.nombre === 'Fondos');",
                  "pm.test('Existe la categoría Fondos (seed_demo.sql)', () => pm.expect(fondos).to.exist);",
                  "pm.collectionVariables.set('fondosId', fondos.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{django}}/api/catalogo/categorias/"
          }
        },
        {
          "name": "Carta (Norte): guarda la Limonada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const limonada = pm.response.json().find(p => p.nombre === 'Limonada');",
                  "pm.test('La Sede Norte tiene Limonada (seed_demo.sql)', () => pm.expect(limonada).to.exist);",
                  "pm.collectionVariables.set('limonadaNorteId', limonada.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{django}}/api/catalogo/productos/",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenNorte}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Crear platillo → 201 (nace ACTIVO)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('platilloNuevo', 'Platillo Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test('Nace ACTIVO aunque el body diga INACTIVO', () => pm.expect(r.estado).to.eql('ACTIVO'));",
                  "pm.collectionVariables.set('platilloId', r.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
