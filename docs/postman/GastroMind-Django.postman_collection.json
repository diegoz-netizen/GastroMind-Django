              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Sigue en la BD como INACTIVO', () => pm.expect(pm.response.json().estado).to.eql('INACTIVO'));"
                ]
              }
