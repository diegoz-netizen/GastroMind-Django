# Copiar a .env y completar. El .env NO se sube al repo.

# Django
DJANGO_SECRET_KEY=genera-una-con: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Misma BD PostgreSQL que usa Spring Boot (docs/script_database.sql del repo GastroMind)
DB_NAME=gastromind_db
DB_USER=postgres
DB_PASSWORD=TU_PASSWORD_POSTGRES
DB_HOST=localhost
DB_PORT=5432

# MISMO valor que gastromind.jwt.secret del application-local.properties de Spring
JWT_SECRET=TU_JWT_SECRET_DE_SPRING

# Orígenes del frontend React
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
